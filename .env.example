# Copie para .env.docker (container) ou .env (npm run start:dev).
# Gere cada segredo com: openssl rand -hex 32
#
# O que NAO existe mais aqui, e nao deve voltar:
#
#   SSO_ADMIN_SECRET, SSO_SUPERADMIN_SECRET
#     A autorizacao das rotas administrativas vem do banco. O SSO e um
#     Project de si mesmo, e quem administra e um User com papel em
#     ProjectUser. O primeiro SUPERADMIN de cada ambiente nasce do SQL de
#     primeira subida, que fica fora de todo repositorio.
#
#   Qualquer clientId, projectId ou e-mail de usuario
#     Sao linhas do banco. Ler do env criaria uma segunda verdade, que
#     envelhece sem ninguem perceber.

# ------------------------------- Banco --------------------------------- #
# Dentro do compose use host.docker.internal; fora dele, 127.0.0.1.
DATABASE_URL=postgresql://postgres:senha@host.docker.internal:5432/sso?schema=public
# Banco descartavel, so para `prisma migrate diff --from-migrations`.
SHADOW_DATABASE_URL=

# ----------------------------- Identidade ------------------------------ #
# Base publica, com o prefixo global e sem barra final. Vira a claim `iss`.
SSO_ISSUER=http://localhost:8080/sso

# Tela de login do IdP, no front do SSO. Sem sessao, /oauth/authorize manda a
# pessoa para ca, e nao direto ao Google. E fato de deploy, como SSO_ISSUER: so
# quem sobe o front sabe onde ele esta.
SSO_LOGIN_URL=http://localhost:5173/login

# ------------------------------ Segredos ------------------------------- #
# Cifra as chaves privadas de assinatura guardadas em SigningKey.
# NAO pode morar no banco: e ela que decifra o que esta la. Perder esta
# chave invalida todas as chaves de assinatura ja gravadas.
KEY_ENCRYPTION_KEY=

# Cifra os cookies de transacao e de sessao do proprio SSO.
COOKIE_SECRET=

# ------------------------------ Cookies -------------------------------- #
# RFC 10017 secao 6.1.3.2 exige Secure e HttpOnly. `false` so em localhost
# sem TLS: com Secure ligado, o cookie ganha o prefixo `__Host-`.
COOKIE_SECURE=false
# `strict` e o padrao, como pede a RFC 10017 secao 6.1.3.2. SameSite compara
# SITE, nao origem: porta e subdominio nao contam, entao localhost:8080 e
# localhost:3000 sao o mesmo site, e sso.exemplo.com e app.exemplo.com tambem.
# So baixe para `lax` se o SSO viver em outro dominio registravel.
COOKIE_SAMESITE=strict

# ------------------------------- Tempos -------------------------------- #
# Segundos. Access token curto conforme RFC 9700 secao 2.3.
ACCESS_TOKEN_TTL=900
# Teto absoluto do refresh token, nunca estendido na rotacao. 90 dias.
REFRESH_TOKEN_TTL=7776000
# Sessao do usuario com o SSO. E ela que dispensa refazer o login no Google, e
# a RFC 10017 secao 6.3.2.3 amarra a vida do refresh token a ela: sessao curta
# aqui mata um refresh token longo, por mais folgado que ele seja. 90 dias.
#
# Vida longa aqui e aceitavel porque isto e uma LINHA NO BANCO, revogavel a
# qualquer momento. O mesmo nao vale para o access token, que e assinado e nao
# consultado: por isso ele continua curto.
AUTH_SESSION_TTL=7776000

# ------------------------------- Google -------------------------------- #
# Credencial do SSO como cliente do Google, em
# console.cloud.google.com/apis/credentials. Nada a ver com Project.clientId.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/sso/oauth/google/callback

# ------------------------------- Rede ---------------------------------- #
# Quantos saltos de proxy confiar no `X-Forwarded-For`. Sem isto, o IP de quem
# pediu e o do proxy, e o limite de requisicoes conta todo mundo junto. Ligue
# SO quando houver proxy na frente (nginx do front, load balancer): com acesso
# direto, qualquer um escolheria o proprio IP no cabecalho.
# TRUST_PROXY=1
